# ============================================================
# Variables d'environnement — Reservation directe
# ============================================================
# NE JAMAIS committer de vraies valeurs. Ce fichier ne sert que
# de modele. Les vraies valeurs vont :
#   - en local  : dans .env.local (gitignore)
#   - en prod   : dans Vercel > Settings > Environment Variables
#
# Les cles ci-dessous sont SECRETES (service_role, Stripe secret,
# mot de passe admin) : elles ne doivent apparaitre ni dans le code,
# ni sur GitHub, ni dans le chat.
# ============================================================

# --- Supabase (projet DELFOSSE BOOKING, region Frankfurt) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # Settings > API > service_role (SECRET)

# --- Admin (interface de gestion prix / reservations) ---
ADMIN_PASSWORD=choisis-un-mot-de-passe-long  # protege /api/admin/* (SECRET)

# --- Stripe (lot 3c — mode TEST d'abord) ---
STRIPE_SECRET_KEY=sk_test_...               # (SECRET)
STRIPE_WEBHOOK_SECRET=whsec_...             # (SECRET)
STRIPE_PUBLISHABLE_KEY=pk_test_...          # cote client (public, OK)

# --- Airbnb iCal (deja en place pour le calendrier) ---
AIRBNB_ICAL_01=https://www.airbnb.fr/calendar/ical/....ics?t=...
AIRBNB_ICAL_02=
AIRBNB_ICAL_03=
AIRBNB_ICAL_04=
AIRBNB_ICAL_05=
AIRBNB_ICAL_06=
AIRBNB_ICAL_07=
AIRBNB_ICAL_08=
